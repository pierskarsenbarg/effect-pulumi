{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "noEmit": true,
    "paths": {
      "effect-pulumi": ["./src/index.ts"]
    }
  },
  "include": ["src", "examples", "test"],
  "exclude": ["node_modules", "dist"]
}
