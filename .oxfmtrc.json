{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  // Matches how the tree was already written, so adopting a formatter is not
  // an excuse to rewrite every file. oxfmt's own defaults are printWidth 100
  // and trailingComma "all".
  "printWidth": 80,
  "trailingComma": "es5",

  // On by default. package.json's field order here is deliberate — identity,
  // then entry points, then scripts, then the peer/dev dependency split —
  // and the sort scatters it.
  "sortPackageJson": false,

  "ignorePatterns": [
    // Generated by npm; reformatting it guarantees a conflict on the next
    // `npm install`.
    "package-lock.json",

    // Two reasons, both specific to the prose in this repo. Table alignment
    // measures `—` and `→` as one column each, so the docs' tables come out
    // misaligned in source. And the README's ```ts fences are Effect snippets
    // lifted out of generator bodies: formatted as standalone programs they
    // are not in a generator, so `yield* eaws.s3.Bucket(...)` reparses as the
    // binary expression `yield * eaws...` and the docs silently become wrong.
    "*.md"
  ]
}
